# API calls use relative paths in local development.
NEXT_PUBLIC_API_URL=

# PostHog project settings. Use the values from the PostHog project setup page.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry error tracking. Keep the auth token in Vercel only.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# PostgreSQL
DATABASE_URL=postgresql://kopikita:your-password@localhost:5432/kopikita
