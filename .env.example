# ──────────────────────────────────────────────────────────────────
# Kopi Kita — environment variables
# Copy this file to .env.local and fill in the values.
# Do NOT commit real credentials — this template holds placeholders only.
# ──────────────────────────────────────────────────────────────────

# ── Database (REQUIRED) ─────────────────────────────────────────────
# Postgres connection string.
#   Local (Docker):
#     postgresql://kopikita:kopikita123@localhost:5432/kopikita
#   Production (Neon):
#     postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
DATABASE_URL=

# ── API base URL (optional) ─────────────────────────────────────────
# Leave empty in production (Vercel) — Express runs on the same origin.
# Set to http://localhost:4000 only if running the API as a separate server.
NEXT_PUBLIC_API_URL=

# ── Node environment (optional) ─────────────────────────────────────
# Set automatically by Next.js and the deployment platform (Vercel).
# Only override for a standalone Express dev setup.
# NODE_ENV=development
